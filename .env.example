# ==========================================================================
# HR FAQ & Policy Assistant — environment configuration
# ==========================================================================

# Which LLM to use for final answer generation: "ollama" (local, no key, slow, requires installation)
# or "gemini" (hosted, faster). Default is local so the project runs with no key.
LLM_PROVIDER=ollama

# --- Gemini (hosted) -------------------------------------------------------
# Only needed if LLM_PROVIDER=gemini.
# Get a free API key at https://aistudio.google.com/apikey  (must start with "AIza").
GEMINI_API_KEY=
# Use a real, current model name. "gemini-flash-latest" tracks the latest Flash
# model; alternatively "gemini-2.0-flash". Do NOT use a guessed version number.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Ollama (local, default) ----------------------------------------------
# Only needed if LLM_PROVIDER=ollama. Install from https://ollama.com and run:
#   ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
